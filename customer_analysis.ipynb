import pandas as pd
import matplotlib.pyplot as plt

# Load sales dataset only
sales = pd.read_csv("/content/sales_data (2).csv")

# Convert Date column
sales['Date'] = pd.to_datetime(sales['Date'])

# Extract Year & Month
sales['Year'] = sales['Date'].dt.year
sales['Month'] = sales['Date'].dt.month

# ================= BUSINESS METRICS =================

total_revenue = sales['Total_Sales'].sum()

total_customers = sales['Customer_ID'].nunique()

avg_order_value = sales['Total_Sales'].mean()

customer_value = sales.groupby('Customer_ID')['Total_Sales'].sum().sort_values(ascending=False)

top_customer_id = customer_value.idxmax()
top_customer_value = customer_value.max()

monthly_sales = sales.groupby('Month')['Total_Sales'].sum()

regional_sales = sales.groupby('Region')['Total_Sales'].sum()

top_products = sales.groupby('Product')['Quantity'].sum().sort_values(ascending=False)

# ================= VISUALIZATIONS =================

monthly_sales.plot(kind='line')
plt.title("Monthly Revenue Trend")
plt.xlabel("Month")
plt.ylabel("Revenue")
plt.show()

customer_value.head(10).plot(kind='bar')
plt.title("Top 10 Customers by Revenue")
plt.show()

regional_sales.plot(kind='pie', autopct='%1.1f%%')
plt.title("Sales by Region")
plt.show()

top_products.head(10).plot(kind='bar')
plt.title("Top Products")
plt.show()

# ================= FINAL REPORT =================

print("\n" + "="*50)
print("        CUSTOMER SALES ANALYSIS REPORT")
print("="*50)

print(f"Total Revenue: ${total_revenue:,.0f}")
print(f"Total Customers: {total_customers:,}")
print(f"Average Order Value: ${avg_order_value:,.0f}")
print(f"Top Customer: {top_customer_id} - ${top_customer_value:,.0f}")

print("="*50)
